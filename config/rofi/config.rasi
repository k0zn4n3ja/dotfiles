/* Global rofi theme — Catppuccin Mocha (dark), matches foot. */
configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    bg:          #1e1e2e;
    surface:     #313244;
    fg:          #cdd6f4;
    accent:      #89b4fa;
    urgent:      #f38ba8;
    muted:       #6c7086;

    /* base colors every widget inherits — this is what kills the light default */
    background-color: @bg;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    padding:          16px;
    width:            40%;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
}

inputbar {
    background-color: @surface;
    text-color:       @fg;
    padding:          10px;
    border-radius:    8px;
    margin:           0 0 8px 0;
    children:         [ prompt, entry ];
}

prompt { background-color: transparent; text-color: @accent; margin: 0 8px 0 0; }
entry  { background-color: transparent; text-color: @fg; placeholder: "Search…"; placeholder-color: @muted; }

message { background-color: transparent; }
textbox {
    background-color: @surface;
    text-color:       @fg;
    padding:          6px 10px;
    border-radius:    8px;
}

listview {
    background-color: transparent;
    lines:            12;
    scrollbar:        false;
    spacing:          4px;
}

/* the actual result rows — must override the per-state selectors, not just `element` */
element                  { background-color: transparent; text-color: @fg; padding: 8px; border-radius: 8px; }
element normal.normal    { background-color: transparent; text-color: @fg;  }
element normal.urgent    { background-color: transparent; text-color: @urgent; }
element alternate.normal { background-color: transparent; text-color: @fg;  }
element alternate.urgent { background-color: transparent; text-color: @urgent; }
element selected.normal  { background-color: @accent;     text-color: @bg;  }
element selected.urgent  { background-color: @urgent;     text-color: @bg;  }

element-text { background-color: transparent; text-color: inherit; }
element-icon { background-color: transparent; size: 1.1em; }
