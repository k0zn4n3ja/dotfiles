* {
    font-family: "JetBrainsMono Nerd Font", "Font Awesome 6 Free";
    font-size: 13px;
    font-weight: 600;
    min-height: 0;
}

window#waybar {
    background: rgba(26, 26, 26, 0.95);
    color: #e0e0e0;
}

.modules-left, .modules-center, .modules-right {
    background: transparent;
    padding: 0 4px;
}

#workspaces button {
    padding: 0 8px;
    color: #888;
    background: transparent;
    border-radius: 8px;
}

#workspaces button.active {
    color: #1a1a1a;
    background: linear-gradient(45deg, #33ccff, #00ff99);
}

#workspaces button:hover {
    color: #33ccff;
    background: rgba(51, 204, 255, 0.15);
}

#window { color: #b0b0b0; padding: 0 10px; }

#clock { color: #33ccff; padding: 0 10px; }

#tray, #pulseaudio, #backlight, #network, #battery {
    padding: 0 10px;
}

#battery.warning  { color: #ffcc33; }
#battery.critical { color: #ff5555; }
#battery.charging { color: #00ff99; }

#pulseaudio.muted { color: #ff5555; }

tooltip {
    background: #1a1a1a;
    border: 1px solid #33ccff;
    border-radius: 8px;
}
tooltip label { color: #e0e0e0; }
